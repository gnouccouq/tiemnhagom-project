{
  "expo": {
    "name": "Tiệm Nhà Gốm",
    "slug": "tiemnhagom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "tiemnhagom",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#9C7156",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.tiemnhagom.app",
      "buildNumber": "1",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần quyền truy cập camera để bạn có thể chụp ảnh trực tiếp làm ảnh đại diện cho tài khoản cá nhân.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần quyền truy cập thư viện ảnh để bạn có thể tải lên ảnh đại diện cá nhân hoặc gửi ảnh minh chứng lỗi sản phẩm cho bộ phận hỗ trợ."
      }
    },
    "android": {
      "package": "vn.tiemnhagom.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#9C7156",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/LOGO.jpg"
    },
    "updates": {
      "url": "https://u.expo.dev/19342074-41d2-4d48-a369-96a94f445a4a",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/LOGO_2_PNG.png",
          "resizeMode": "contain",
          "backgroundColor": "#9C7156"
        }
      ],
      "expo-image",
      "@react-native-google-signin/google-signin",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ứng dụng cần quyền sử dụng Face ID để xác thực khi mở khóa ứng dụng."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "19342074-41d2-4d48-a369-96a94f445a4a"
      }
    },
    "owner": "tiemnhagom"
  }
}
