rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra xem User có phải là Admin không
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Kiểm tra xem user hiện tại có phải là Super Admin không
    function isSuperAdmin() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Kiểm tra xem dữ liệu không bị thay đổi các trường cấm
    function isUnchanged(key) {
      return (key in resource.data) && (key in request.resource.data) 
        && (resource.data[key] == request.resource.data[key]);
    }

    // 1. Sản phẩm (products)
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        // Cho phép cập nhật tồn kho, số lượng bán và các mảng biến thể
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'sold', 'colorVariants', 'patternVariants', 'comboVariants', 'comboItems']) &&
        // Kiểm tra tính hợp lệ của dữ liệu số
        request.resource.data.stock is int &&
        request.resource.data.sold is int &&
        // LOGIC BẢO VỆ KHO: Tồn kho mới phải nhỏ hơn hoặc bằng tồn kho cũ (không được tự ý tăng kho)
        request.resource.data.stock <= resource.data.stock &&
        // Tồn kho không được âm
        request.resource.data.stock >= 0 &&
        // Số lượng bán mới phải lớn hơn hoặc bằng cũ
        request.resource.data.sold >= resource.data.sold
      );
    }
    
    // 2. Danh sách Admin
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if isSuperAdmin(); 
    }

    // 3. Giỏ hàng & Yêu thích
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Thông tin người dùng (users)
    match /users/{userId} {
      // Cho phép đọc thông tin cá nhân và tìm kiếm tài khoản
      allow read: if true;

      // Khách hàng tạo tài khoản mới hoặc ghost account khi đặt hàng:
      // Điểm ban đầu không được tự ý gán > 0, hạng phải là standard, không được tự cấp quyền admin
      allow create: if isAdmin() || (
        (!('points' in request.resource.data) || request.resource.data.points == 0) &&
        (!('tier' in request.resource.data) || request.resource.data.tier == 'standard') &&
        (!('role' in request.resource.data) || request.resource.data.role != 'admin')
      );

      // Cập nhật thông tin:
      // - Admin có toàn quyền (cộng điểm, sửa hạng hội viên, đổi thông tin)
      // - Người dùng thường chỉ được sửa thông tin cá nhân (tên, avatar, địa chỉ, sđt,...), cập nhật hạng/tổng chi tiêu đồng bộ đơn hàng
      // - TUYỆT ĐỐI CẤM người dùng thường tự ý sửa points, role
      allow update: if isAdmin() || (
        (
          // Người dùng cập nhật tài khoản của chính mình
          (request.auth != null && request.auth.uid == userId) ||
          // Hoặc liên kết tài khoản / tài khoản phụ
          (request.auth != null && resource.data.mergedTo == request.auth.uid) ||
          (request.auth != null && request.resource.data.mergedTo == request.auth.uid) ||
          // Hoặc ghost account do hệ thống tạo khi mua hàng
          (resource.data.isGhost == true)
        ) && (
          // BẢO VỆ ĐIỂM THƯỞNG: Cấm client tự ý sửa đổi điểm gốm (points)
          isUnchanged('points') || !('points' in request.resource.data)
        ) && (
          // BẢO VỆ PHÂN QUYỀN: Cấm client tự gán quyền Admin cho chính mình
          !('role' in request.resource.data) || request.resource.data.role != 'admin'
        )
      );

      allow delete: if isSuperAdmin() || (request.auth != null && resource.data.isGhost == true);
    }

    // 5. Đơn hàng (orders)
    match /rental_orders/{orderId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isAdmin() || (
        (
          (request.auth != null && request.resource.data.userId == request.auth.uid) || 
          (request.resource.data.userId == 'guest')
        ) && (
          request.resource.data.totalAmount is number && 
          request.resource.data.totalAmount >= 0 &&
          (request.resource.data.status == "Đang xử lý" || request.resource.data.status == "Yêu cầu mới") &&
          request.resource.data.items is list &&
          request.resource.data.items.size() > 0 &&
          request.resource.data.orderDate == request.time
        )
      );

      // Cho phép tra cứu chi tiết đơn hàng đơn lẻ khi biết mã
      allow get: if true;

      // Bảo vệ danh sách toàn bộ đơn hàng:
      // - Admin được xem toàn bộ
      // - Người dùng đã đăng nhập chỉ được xem danh sách đơn hàng của chính mình
      // - Khách vãng lai chỉ được truy vấn danh sách khi có bộ lọc SĐT
      allow list: if isAdmin() || 
        (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.customerId == request.auth.uid)) ||
        (resource.data.shippingAddress.phone != null);

      // Cấu trúc update chặt chẽ cho người dùng
      allow update: if isAdmin() || (
        request.auth != null && (
          // Trường hợp 1: Người dùng tự hủy đơn của chính mình
          (request.auth.uid == resource.data.userId && 
           resource.data.status == "Đang xử lý" && request.resource.data.status == "Đã hủy" && 
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'canceledBy', 'canceledAt']) &&
           isUnchanged('totalAmount') && isUnchanged('userId')) ||
          
          // Trường hợp 2: Liên kết đơn hàng cũ dựa trên SĐT đã xác thực
          (resource.data.userId != request.auth.uid && 
           request.resource.data.userId == request.auth.uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId']) &&
           (resource.data.shippingAddress.phone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone ||
            resource.data.shippingAddress.phone.matches('.*' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone))
          )
        )
      );

      // Chỉ Super Admin mới được xóa đơn hàng (thường là để dọn dẹp data lỗi)
      allow delete: if isSuperAdmin();
    }

    // 6. Cấu hình hệ thống (Danh mục động, Banners, Sự kiện...)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin(); // Cho phép Admin quản lý các cấu hình cài đặt
    }

    // 7. Mã giảm giá (coupons)
    match /coupons/{couponId} {
      allow read: if true;
      // Cho phép Super Admin tạo/xóa coupon, HOẶC hệ thống client tự động sinh voucher thăng hạng / sinh nhật (assignedTo == request.auth.uid) hoặc voucher tặng người thân (assignedBy == request.auth.uid)
      allow create: if isSuperAdmin() || (
        request.auth != null &&
        request.resource.data.isAutoGenerated == true &&
        (request.resource.data.assignedTo == request.auth.uid || request.resource.data.assignedBy == request.auth.uid) &&
        request.resource.data.limit == 1 &&
        request.resource.data.usedCount == 0
      );
      allow delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }

    // 8. Đánh giá (reviews)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin() || (request.auth != null && resource.data.userId == request.auth.uid); // Super Admin hoặc chính chủ
    }

    // 9. Tin tức (news)
    match /news/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Nhật ký kho (inventory_logs)
    match /inventory_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // 11. Đăng ký nhận tin khi có hàng lại (restock_alerts)
    match /restock_alerts/{alertId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 12. Tin nhắn liên hệ (contact_messages)
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 13. Đăng ký nhận thông báo Lookbook ra mắt (lookbook_subscribers)
    match /lookbook_subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 14. Thông báo toàn cục từ Dashboard (global_notifications)
    match /global_notifications/{notifId} {
      allow read: if true;           // App đọc để hiện in-app
      allow create: if isAdmin();    // Chỉ Admin Dashboard mới được gửi
      allow update, delete: if isAdmin();
    }

    // 15. Cấu hình app chung (Force Update, etc)
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

