{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".git/**",
      "**/.*",
      "**/node_modules/**",
      "tiemnhagom-app/**",
      "android/**",
      "ios/**",
      "functions/**",
      "firestore.rules",
      "storage.rules",
      "*.apk",
      "*.log",
      "*.md"
    ],


    "redirects": [
      {
        "source": "/*/lookbook",
        "destination": "/lookbook/",
        "type": 301
      },
      {
        "source": "/*/lookbook/**",
        "destination": "/lookbook/",
        "type": 301
      },
      {
        "source": "/chinh-sach-gia.html",
        "destination": "/chinh-sach/chinh-sach-gia.html",
        "type": 301
      },
      {
        "source": "/buying-guide.html",
        "destination": "/chinh-sach/buying-guide.html",
        "type": 301
      },
      {
        "source": "/shipping-policy.html",
        "destination": "/chinh-sach/shipping-policy.html",
        "type": 301
      },
      {
        "source": "/giai-quyet-khieu-nai.html",
        "destination": "/chinh-sach/giai-quyet-khieu-nai.html",
        "type": 301
      },
      {
        "source": "/payment-policy.html",
        "destination": "/chinh-sach/payment-policy.html",
        "type": 301
      },
      {
        "source": "/return-refund-policy.html",
        "destination": "/chinh-sach/return-refund-policy.html",
        "type": 301
      },
      {
        "source": "/privacy-policy.html",
        "destination": "/chinh-sach/privacy-policy.html",
        "type": 301
      },
      {
        "source": "/terms-of-service.html",
        "destination": "/chinh-sach/terms-of-service.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/share",
        "function": "shareRedirect"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
